{
  "name": "@sigma/demo",
  "private": true,
  "homepage": "/demo",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "compile-proto": "mkdir -p src/generated/ && protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=esModuleInterop=true,forceLong=string,outputClientImpl=grpc-web --proto_path=./proto ./proto/*.proto && python3 -m grpc_tools.protoc -I proto/ --python_out=python/ --grpc_python_out=python/ relationship.proto",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "@improbable-eng/grpc-web": "0.15.0",
    "@react-sigma/core": "^5.0.4",
    "@sigma/node-image": ">=3.0.0",
    "@types/long": "^5.0.0",
    "browser-headers": "0.4.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "grpc-web": "1.5.0",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-animate-height": "^3.2.3",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "sigma": ">=3.0.0-beta.33"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.55.1",
    "@bufbuild/protoc-gen-es": "^2.5.2",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.7.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-checker": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
